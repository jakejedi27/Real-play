# Server runtime (never expose these to the browser bundle)
PORT=3000
DATA_DIR=./data

# storage: "sqlite" (default, verified) or "supabase"
DATA_STORE=sqlite

# Supabase mode (server-side only; service role key must never reach the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: restrict browser origins allowed to call the API
ALLOWED_ORIGIN=

# Scheduler tick interval (ms)
SCHEDULER_TICK_MS=1000
